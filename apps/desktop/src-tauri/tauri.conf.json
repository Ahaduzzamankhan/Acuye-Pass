{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acuye Pass",
  "version": "0.1.4",
  "identifier": "com.fluxenite.acuyepass",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Acuye Pass",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; media-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        "default"
      ],
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBRjkzMEUxOTU1N0ZGMUMKUldRYy8xZVY0VEQ1K2pnNnZxdkNDczhFZDNiazdmRkYrb3pkWnNxdTJTM1lLb2M4MmdQNmU0a1YK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Fluxenite",
    "copyright": "Copyright © 2026 Fluxenite",
    "category": "Utility",
    "shortDescription": "Privacy-focused password manager",
    "longDescription": "Acuye Pass is a local-first, encrypted password manager for Windows. Your vault never leaves your device unless you export it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
