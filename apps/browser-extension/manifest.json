{
  "manifest_version": 3,
  "name": "Acuye Pass",
  "version": "0.1.0",
  "description": "Fill logins from your local Acuye Pass vault. No cloud account, no telemetry.",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Acuye Pass",
    "default_popup": "popup.html"
  }
}
